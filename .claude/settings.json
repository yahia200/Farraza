{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(./apps/api/.env)",
      "Read(./apps/api/.env.*)",
      "Read(./apps/web/.env.local)",
      "Read(./apps/web/.env.*)",
      "Read(./**/.env)",
      "Read(./**/.env.*)"
    ],
    "allow": [
      "Bash(pnpm lint:*)",
      "Bash(pnpm build:*)",
      "Bash(pnpm check-types:*)",
      "Bash(pnpm format:*)",
      "Bash(pnpm --filter api test:*)",
      "Bash(pnpm --filter api lint:*)",
      "Bash(pnpm --filter api exec vitest:*)",
      "Bash(pnpm --filter web lint:*)",
      "Bash(pnpm --filter @repo/shared test:*)",
      "Bash(pnpm --filter @repo/shared build:*)",
      "Bash(pnpm --filter @repo/shared exec vitest:*)",
      "Bash(pnpm --filter api exec prisma:* --help)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git worktree list:*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/after-edit-reminders.mjs\""
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR:-.}/.trail/hook.cjs\" session-start || exit 0",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
