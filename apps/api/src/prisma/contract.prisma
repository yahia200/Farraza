// use prisma-8

enum MemberRole {
  Owner       = "owner"
  Admin       = "admin"
  Recruiter   = "recruiter"
  Interviewer = "interviewer"
}

enum JobStatus {
  Draft  = "draft"
  Open   = "open"
  Closed = "closed"
}

enum StageKind {
  Normal   = "normal"
  Hired    = "hired"
  Rejected = "rejected"
}

enum PublicLabel {
  Received  = "received"
  InReview  = "in_review"
  Interview = "interview"
  Offer     = "offer"
  Closed    = "closed"
}

model User {
  id           Uuid                       @id @default(sql`gen_random_uuid()`)
  email        String                     @unique
  emailVerified Boolean                    @default(false) @map("email_verified")
  passwordHash String?                     @map("password_hash")
  name         String
  createdAt    TimestamptzJsDate          @default(now()) @map("created_at")
  updatedAt    temporal.updatedAtJsDate() @map("updated_at")

  memberships Membership[]

  @@check(expression: "email = lower(email)", name: "users_email_lowercase")
  @@map("users")
}

model Company {
  id         Uuid                       @id @default(sql`gen_random_uuid()`)
  name       String
  slug       String                     @unique
  logoUrl    String?                    @map("logo_url")
  brandColor String?                   @map("brand_color")
  createdAt  TimestamptzJsDate          @default(now()) @map("created_at")
  updatedAt  temporal.updatedAtJsDate() @map("updated_at")

  memberships Membership[]

  @@check(expression: "slug ~ '^[a-z0-9][a-z0-9-]{1,38}[a-z0-9]$'", name: "companies_slug_format")
  @@check(expression: "brand_color ~ '^#[0-9a-fA-F]{6}$'", name: "companies_brand_color_format")
  @@map("companies")
}

model Membership {
  id        Uuid              @id @default(sql`gen_random_uuid()`)
  userId    Uuid              @map("user_id")
  companyId Uuid              @map("company_id")
  role      MemberRole
  createdAt TimestamptzJsDate @default(now()) @map("created_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([userId, companyId])
  @@index([companyId])
  @@map("memberships")
}

model Job {
  id          Uuid                       @id @default(sql`gen_random_uuid()`)
  companyId   Uuid                       @map("company_id")
  title       String
  slug        String
  description String?
  status      JobStatus                  @default(Draft)
  createdById Uuid?                      @map("created_by")
  openedAt    TimestamptzJsDate?         @map("opened_at")
  closedAt    TimestamptzJsDate?         @map("closed_at")
  /// Highlighted questions: up to three Question keys (`highlightedQuestionKeysSchema` in @repo/shared). No FK: the keys live in form_versions.fields.
  highlightedQuestionKeys Jsonb          @default(json`[]`) @map("highlighted_question_keys")
  /// Rating Criteria: up to five catalog keys (`ratingCriteriaKeysSchema` in @repo/shared) raters may score. No FK: the keys come from a fixed catalog and live in a JSONB array.
  ratingCriteria Jsonb                   @default(json`[]`) @map("rating_criteria")
  /// Screening rules: up to 20 rules (`screeningRuleSchema` in @repo/shared), each about one top-level question. No FK: the question keys and option ids live in form_versions.fields.
  screeningRules Jsonb                   @default(json`[]`) @map("screening_rules")
  createdAt   TimestamptzJsDate          @default(now()) @map("created_at")
  updatedAt   temporal.updatedAtJsDate() @map("updated_at")

  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdBy User?   @relation(fields: [createdById], references: [id], onDelete: SetNull)
  stages    Stage[]

  @@unique([companyId, slug])
  @@index([companyId, status])
  @@check(expression: "slug ~ '^[a-z0-9][a-z0-9-]{1,78}[a-z0-9]$'", name: "jobs_slug_format")
  @@check(expression: "jsonb_typeof(highlighted_question_keys) = 'array'", name: "jobs_highlighted_question_keys_array")
  @@check(expression: "jsonb_typeof(rating_criteria) = 'array'", name: "jobs_rating_criteria_array")
  @@check(expression: "jsonb_typeof(screening_rules) = 'array'", name: "jobs_screening_rules_array")
  @@map("jobs")
}

model Stage {
  id          Uuid                       @id @default(sql`gen_random_uuid()`)
  companyId   Uuid                       @map("company_id")
  jobId       Uuid                       @map("job_id")
  name        String
  position    Int
  kind        StageKind                  @default(Normal)
  publicLabel PublicLabel                @default(InReview) @map("public_label")
  createdAt   TimestamptzJsDate          @default(now()) @map("created_at")
  updatedAt   temporal.updatedAtJsDate() @map("updated_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  job     Job     @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([jobId, position])
  @@unique([jobId, name])
  @@map("stages")
}

enum CvMode {
  Off      = "off"
  Optional = "optional"
  Required = "required"
}

model FormVersion {
  id          Uuid                       @id @default(sql`gen_random_uuid()`)
  companyId   Uuid                       @map("company_id")
  jobId       Uuid                       @map("job_id")
  version     Int
  fields      Jsonb                      @default(json`[]`)
  /// Whether the form asks for a CV (ADR-0002). Existing versions are `off`; the builder starts new jobs at `optional`.
  cvMode      CvMode                     @default(Off) @map("cv_mode")
  publishedAt TimestamptzJsDate?         @map("published_at")
  createdById Uuid?                      @map("created_by")
  createdAt   TimestamptzJsDate          @default(now()) @map("created_at")
  updatedAt   temporal.updatedAtJsDate() @map("updated_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  job     Job     @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([jobId, version])
  @@index([jobId], where: "(published_at IS NULL)", unique: true, name: "form_versions_one_draft")
  @@check(expression: "version > 0", name: "form_versions_version_positive")
  @@map("form_versions")
}

enum ApplicationStatus {
  Active    = "active"
  Rejected  = "rejected"
  Hired     = "hired"
  Withdrawn = "withdrawn"
}

enum ApplicationEventType {
  Applied      = "applied"
  AutoRejected = "auto_rejected"
  StageChanged = "stage_changed"
  Rejected     = "rejected"
  Hired        = "hired"
  Withdrawn    = "withdrawn"
  NoteAdded    = "note_added"
  Rated        = "rated"
  Flagged      = "flagged"
}

model Candidate {
  id        Uuid                       @id @default(sql`gen_random_uuid()`)
  companyId Uuid                       @map("company_id")
  email     String
  name      String
  phone     String
  createdAt TimestamptzJsDate          @default(now()) @map("created_at")
  updatedAt temporal.updatedAtJsDate() @map("updated_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, email])
  @@check(expression: "email = lower(email)", name: "candidates_email_lowercase")
  @@check(expression: "phone ~ '^[+][1-9][0-9]{6,14}$'", name: "candidates_phone_format")
  @@map("candidates")
}

model Application {
  id                  Uuid                       @id @default(sql`gen_random_uuid()`)
  companyId           Uuid                       @map("company_id")
  jobId               Uuid                       @map("job_id")
  candidateId         Uuid                       @map("candidate_id")
  /// The contact details this application was submitted with (the candidate row keeps the latest).
  email               String
  /// E.164, normalised by phoneSchema in @repo/shared, so the same number is always the same text.
  phone               String
  formVersionId       Uuid                       @map("form_version_id")
  stageId             Uuid                       @map("stage_id")
  status              ApplicationStatus          @default(Active)
  answers             Jsonb                      @default(json`{}`)
  source              String?
  /// The flag-outcome Screening rules that fired at submit: [{ ruleId, questionKey, questionLabel, reason }]. Stored text, so later rule edits never rewrite it. No FK.
  flags               Jsonb                      @default(json`[]`)
  rejectionNotifiedAt TimestamptzJsDate?         @map("rejection_notified_at")
  submittedAt         TimestamptzJsDate          @default(now()) @map("submitted_at")
  updatedAt           temporal.updatedAtJsDate() @map("updated_at")

  company     Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  job         Job         @relation(fields: [jobId], references: [id], onDelete: NoAction)
  candidate   Candidate   @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  formVersion FormVersion @relation(fields: [formVersionId], references: [id], onDelete: NoAction)
  stage       Stage       @relation(fields: [stageId], references: [id], onDelete: NoAction)

  @@unique([jobId, candidateId])
  // One application per job per email, and per phone: a second email can't get a second application in.
  @@unique([jobId, email])
  @@unique([jobId, phone])
  @@check(expression: "email = lower(email)", name: "applications_email_lowercase")
  @@check(expression: "phone ~ '^[+][1-9][0-9]{6,14}$'", name: "applications_phone_format")
  @@check(expression: "jsonb_typeof(flags) = 'array'", name: "applications_flags_array")
  @@index([jobId, stageId])
  @@index([candidateId])
  @@map("applications")
}

model ApplicationEvent {
  id            Uuid                 @id @default(sql`gen_random_uuid()`)
  companyId     Uuid                 @map("company_id")
  applicationId Uuid                 @map("application_id")
  type          ApplicationEventType
  fromStageId   Uuid?                @map("from_stage_id")
  toStageId     Uuid?                @map("to_stage_id")
  actorId       Uuid?                @map("actor_id")
  data          Jsonb                @default(json`{}`)
  createdAt     TimestamptzJsDate    @default(now()) @map("created_at")

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId, createdAt])
  @@map("application_events")
}

model Note {
  id            Uuid                       @id @default(sql`gen_random_uuid()`)
  companyId     Uuid                       @map("company_id")
  applicationId Uuid                       @map("application_id")
  authorId      Uuid?                      @map("author_id")
  body          String
  createdAt     TimestamptzJsDate          @default(now()) @map("created_at")
  updatedAt     temporal.updatedAtJsDate() @map("updated_at")

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  author      User?       @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([applicationId, createdAt])
  @@check(expression: "length(trim(body)) > 0", name: "notes_body_not_blank")
  @@map("notes")
}

model Rating {
  id            Uuid                       @id @default(sql`gen_random_uuid()`)
  companyId     Uuid                       @map("company_id")
  applicationId Uuid                       @map("application_id")
  userId        Uuid?                      @map("user_id")
  overall       SmallInt
  criteria      Jsonb                      @default(json`{}`)
  createdAt     TimestamptzJsDate          @default(now()) @map("created_at")
  updatedAt     temporal.updatedAtJsDate() @map("updated_at")

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  user        User?       @relation(fields: [userId], references: [id], onDelete: SetNull)

  // One Rating per Member per Application; also the index for the board's grouped read by application_id.
  @@unique([applicationId, userId])
  @@check(expression: "overall BETWEEN 1 AND 5", name: "ratings_overall_range")
  @@check(expression: "jsonb_typeof(criteria) = 'object'", name: "ratings_criteria_object")
  @@map("ratings")
}

enum FilePurpose {
  Cv     = "cv"
  Answer = "answer"
}

enum FileStatus {
  Pending  = "pending"
  Uploaded = "uploaded"
}

/// An applicant's upload: the CV, or the answer to a file question. Rows exist before the Application does.
model File {
  id              Uuid               @id @default(sql`gen_random_uuid()`)
  companyId       Uuid               @map("company_id")
  jobId           Uuid               @map("job_id")
  /// Set when the form is submitted; NULL while the file is only uploaded.
  applicationId   Uuid?              @map("application_id")
  purpose         FilePurpose
  /// The file question's key; only for `purpose = 'answer'`.
  fieldKey        Uuid?              @map("field_key")
  storageKey      String             @unique @map("storage_key")
  originalName    String             @map("original_name")
  /// The real type, detected from the file's bytes (not the browser's claim).
  mimeType        String             @map("mime_type")
  sizeBytes       BigIntNumber       @map("size_bytes")
  /// What the browser declared for video and audio; the server doesn't re-measure it.
  durationSeconds Int?               @map("duration_seconds")
  status          FileStatus         @default(Pending)
  uploadedAt      TimestamptzJsDate? @map("uploaded_at")
  createdAt       TimestamptzJsDate  @default(now()) @map("created_at")

  company     Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  job         Job          @relation(fields: [jobId], references: [id], onDelete: Cascade)
  application Application? @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
  @@index([companyId])
  @@index([jobId])
  @@index([status, createdAt])
  // One CV per application.
  @@index([applicationId], where: "(purpose = 'cv')", unique: true, name: "files_one_cv_per_application")
  @@check(expression: "(purpose = 'answer') = (field_key IS NOT NULL)", name: "files_field_key_matches_purpose")
  @@check(expression: "size_bytes > 0", name: "files_size_positive")
  @@check(expression: "duration_seconds IS NULL OR duration_seconds > 0", name: "files_duration_positive")
  @@map("files")
}

enum CvTextStatus {
  Readable   = "readable"
  Unreadable = "unreadable"
  Failed     = "failed"
}

/// The text the applicant's browser read from their CV, with what the server derived from it (ADR-0006). One row per CV file, written with the Application. Never returned by any route.
model CvText {
  id               Uuid              @id @default(sql`gen_random_uuid()`)
  companyId        Uuid              @map("company_id")
  jobId            Uuid              @map("job_id")
  fileId           Uuid              @unique @map("file_id")
  status           CvTextStatus
  /// Cut at CV_TEXT_CAP. Empty for `failed` ("not read") and short for `unreadable`.
  text             String
  /// The shared extractor's output for `text` and the Application's form version (CvSuggestions). Computed on the server, never taken from the client.
  result           Jsonb             @default(json`{}`)
  /// CV_EXTRACTOR_VERSION when `result` was computed, so improved heuristics can re-run over old text.
  extractorVersion Int               @map("extractor_version")
  createdAt        TimestamptzJsDate @default(now()) @map("created_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  job     Job     @relation(fields: [jobId], references: [id], onDelete: Cascade)
  file    File    @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@check(expression: "jsonb_typeof(result) = 'object'", name: "cv_texts_result_object")
  @@index([companyId])
  @@index([jobId])
  @@map("cv_texts")
}

/// One immutable version of a Job's Requirements (keyword match, Layer 2). The Job's current version is its highest `version`. Written only when a save changes the list; never updated.
model JobRequirementVersion {
  id           Uuid              @id @default(sql`gen_random_uuid()`)
  companyId    Uuid              @map("company_id")
  jobId        Uuid              @map("job_id")
  version      Int
  /// The Requirement list (`requirementsSchema` in @repo/shared); `[]` is a valid version. No FK: the ids live inside the array and are referenced by later result rows.
  requirements Jsonb
  createdAt    TimestamptzJsDate @default(now()) @map("created_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  job     Job     @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([jobId, version])
  @@index([companyId])
  @@check(expression: "version > 0", name: "job_requirement_versions_version_positive")
  @@check(expression: "jsonb_typeof(requirements) = 'array'", name: "job_requirement_versions_requirements_array")
  @@map("job_requirement_versions")
}

/// What a Job's Requirements said about one Application's CV text (keyword match, Layer 2). At most one row per Application: written in the submit transaction, replaced by a Re-check. Never returned to the public.
model ApplicationRequirementResult {
  id             Uuid              @id @default(sql`gen_random_uuid()`)
  companyId      Uuid              @map("company_id")
  jobId          Uuid              @map("job_id")
  applicationId  Uuid              @unique @map("application_id")
  /// The `job_requirement_versions.version` of this Job that was checked. No FK: (job_id, version) names the row, and the Job's cascade removes both.
  version        Int
  /// Per Requirement id: { matched, terms } (RequirementMatches in @repo/shared). `{}` for a version with no Requirements.
  results        Jsonb
  /// True when a must-have Requirement did not match (`missedMustHave` in @repo/shared), stored so lists and boards need not re-derive it.
  missedMustHave Boolean           @map("missed_must_have")
  checkedAt      TimestamptzJsDate @default(now()) @map("checked_at")

  company     Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  job         Job         @relation(fields: [jobId], references: [id], onDelete: Cascade)
  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@check(expression: "version > 0", name: "application_requirement_results_version_positive")
  @@check(expression: "jsonb_typeof(results) = 'object'", name: "application_requirement_results_results_object")
  @@index([companyId])
  @@index([jobId, version])
  @@map("application_requirement_results")
}

enum MatchScoreStatus {
  Pending   = "pending"
  Scored    = "scored"
  NotScored = "not_scored"
}

enum MatchScoreReason {
  CvUnreadable   = "cv_unreadable"
  EmbedderFailed = "embedder_failed"
  ModelChanged   = "model_changed"
}

/// The embedding of one Requirement's sentence, per Job and Requirements version (embedding match, Layer 3, ADR-0008). Written insert-or-ignore, never updated: versions are immutable, and a model change is a deliberate re-embed.
model RequirementEmbedding {
  id            Uuid              @id @default(sql`gen_random_uuid()`)
  companyId     Uuid              @map("company_id")
  jobId         Uuid              @map("job_id")
  /// The `job_requirement_versions.version` of this Job. No FK: (job_id, version) names the row, and the Job's cascade removes both.
  version       Int
  /// A Requirement's `id` inside that version's JSONB list. No FK: it lives inside an array.
  requirementId Uuid              @map("requirement_id")
  model         String
  /// The length the writer declared. The database does not check `vector` against it; the service does (ADR-0008, gate result).
  dimensions    Int
  /// `real[]`, not `Float[]` (which is `float8[]`): ADR-0008, gate result.
  vector        Real[]
  createdAt     TimestamptzJsDate @default(now()) @map("created_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  job     Job     @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([jobId, version, requirementId])
  @@index([companyId])
  @@check(expression: "version > 0", name: "requirement_embeddings_version_positive")
  @@check(expression: "dimensions > 0", name: "requirement_embeddings_dimensions_positive")
  @@map("requirement_embeddings")
}

/// The embedding of one chunk of an Application's CV text (embedding match, Layer 3). The chunk text is not stored: it is recomputed from `cv_texts` with the same `chunkerVersion`. Replaced as a set when the Application is scored again; deleted with the Application.
model CvChunkEmbedding {
  id             Uuid              @id @default(sql`gen_random_uuid()`)
  companyId      Uuid              @map("company_id")
  jobId          Uuid              @map("job_id")
  applicationId  Uuid              @map("application_id")
  /// The chunk's position in `chunkCvText(text)`, from 0.
  chunkIndex     Int               @map("chunk_index")
  /// CHUNKER_VERSION when the chunk was cut.
  chunkerVersion Int               @map("chunker_version")
  model          String
  /// The length the writer declared; see requirement_embeddings.dimensions.
  dimensions     Int
  vector         Real[]
  createdAt      TimestamptzJsDate @default(now()) @map("created_at")

  company     Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  job         Job         @relation(fields: [jobId], references: [id], onDelete: Cascade)
  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@unique([applicationId, chunkIndex])
  @@index([companyId])
  @@index([jobId])
  @@check(expression: "chunk_index >= 0", name: "cv_chunk_embeddings_chunk_index_nonnegative")
  @@check(expression: "dimensions > 0", name: "cv_chunk_embeddings_dimensions_positive")
  @@map("cv_chunk_embeddings")
}

/// What embedding match (Layer 3) made of one Application: scored, not scored with a reason, or still pending. At most one row per Application. Advisory and never returned to the public.
model ApplicationMatchScore {
  id                  Uuid              @id @default(sql`gen_random_uuid()`)
  companyId           Uuid              @map("company_id")
  jobId               Uuid              @map("job_id")
  applicationId       Uuid              @unique @map("application_id")
  status              MatchScoreStatus
  /// Set exactly when `status` is `not_scored`.
  reason              MatchScoreReason?
  /// The `job_requirement_versions.version` this row was computed against. No FK, as in application_requirement_results.
  requirementsVersion Int               @map("requirements_version")
  /// The embedding model that made the vectors compared; null while pending or for an unreadable CV.
  model               String?
  /// Per Requirement id: its best dot product over the CV's chunks. `{}` unless `scored`.
  scores              Jsonb             @default(json`{}`)
  /// The weighted mean of `scores` (shared `scoreApplication`), kept as a column so a sort is an ordinary ORDER BY. Null unless `scored`. Never displayed.
  score               Float?
  updatedAt           TimestamptzJsDate @default(now()) @map("updated_at")

  company     Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  job         Job         @relation(fields: [jobId], references: [id], onDelete: Cascade)
  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([jobId, requirementsVersion], map: "application_match_scores_job_version_idx")
  @@check(expression: "requirements_version > 0", name: "application_match_scores_version_positive")
  @@check(expression: "jsonb_typeof(scores) = 'object'", name: "application_match_scores_scores_object")
  @@check(expression: "(status = 'not_scored') = (reason IS NOT NULL)", name: "application_match_scores_reason_iff_not_scored")
  @@check(expression: "status = 'scored' OR score IS NULL", name: "application_match_scores_score_only_when_scored")
  @@map("application_match_scores")
}

enum SessionMfa {
  Pending  = "pending"
  Verified = "verified"
}

model Session {
  id           String            @id
  userId       Uuid              @map("user_id")
  createdAt    TimestamptzJsDate @map("created_at")
  expiresAt    TimestamptzJsDate @map("expires_at")
  lastActiveAt TimestamptzJsDate @map("last_active_at")
  mfa          SessionMfa?
  metadata     Jsonb?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

/// A sign-in identity from an OIDC provider (Google) linked to a user. Accounts
/// are linked by (provider, subject), never by email: emails change, subjects don't.
model Identity {
  id        Uuid              @id @default(sql`gen_random_uuid()`)
  userId    Uuid              @map("user_id")
  /// The provider's name in the auth library's options, e.g. "google".
  provider  String
  /// The provider's stable id for the account (the ID token's `sub`).
  subject   String
  createdAt TimestamptzJsDate @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, subject])
  @@index([userId])
  @@map("identities")
}

enum EmailTokenPurpose {
  EmailVerification = "email-verification"
  PasswordReset     = "password-reset"
}

/// Email verification and password reset links, persisted by the EmailTokenStore
/// for @nestjs/authentication. The token itself only exists in the email.
model EmailToken {
  /// SHA-256 of the token.
  id          String            @id
  purpose     EmailTokenPurpose
  userId      Uuid              @map("user_id")
  /// The address the token was sent to, and the only one it works for.
  email       String
  /// Password resets: SHA-256 of the password hash at send time, so any password change invalidates the link.
  fingerprint String?
  createdAt   TimestamptzJsDate @map("created_at")
  expiresAt   TimestamptzJsDate @map("expires_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@index([expiresAt])
  @@map("email_tokens")
}

/// OIDC logins in progress (PKCE verifier, nonce, return path), persisted by the
/// OidcStateStore for @nestjs/authentication and consumed once by the callback.
model OidcState {
  state         String             @id
  provider      String
  nonce         String?
  codeVerifier  String             @map("code_verifier")
  redirectTo    String?            @map("redirect_to")
  /// Link flow ("connect your Google account"): the signed-in user who started it.
  linkUserId    Uuid?              @map("link_user_id")
  /// Link flow: that user's session id, re-checked on the callback.
  linkSessionId String?            @map("link_session_id")
  createdAt     TimestamptzJsDate  @map("created_at")
  expiresAt     TimestamptzJsDate  @map("expires_at")

  linkUser User? @relation(fields: [linkUserId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@check(expression: "(link_user_id IS NULL) = (link_session_id IS NULL)", name: "oidc_states_link_complete")
  @@map("oidc_states")
}

/// A refresh token of @nestjs/authentication's RefreshTokenStore. Each rotation
/// stays in the family of the original sign-in; a spent token coming back
/// revokes the family.
model RefreshToken {
  /// SHA-256 of the token.
  id              String             @id
  familyId        String             @map("family_id")
  userId          Uuid               @map("user_id")
  createdAt       TimestamptzJsDate  @map("created_at")
  expiresAt       TimestamptzJsDate  @map("expires_at")
  /// The family cannot be extended past this, however often it rotates.
  familyExpiresAt TimestamptzJsDate  @map("family_expires_at")
  usedAt          TimestamptzJsDate? @map("used_at")
  /// Claims fixed at sign-in (amr, auth_time, ...) that every token of the family carries.
  claims          Jsonb?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([familyId])
  @@index([userId])
  @@index([familyExpiresAt])
  @@map("refresh_tokens")
}

/// Revoked refresh-token families. A row outlives the tokens of its family on
/// purpose: a refresh that lost a race may still save its successor afterwards,
/// and that token must be refused. No FK for the same reason.
model RevokedRefreshFamily {
  familyId  String            @id @map("family_id")
  expiresAt TimestamptzJsDate @map("expires_at")

  @@index([expiresAt])
  @@map("revoked_refresh_families")
}

/// A User's authenticator app (TOTP), the package's MfaStore. The secret is
/// sealed by the package before it reaches this table.
model MfaTotp {
  userId        Uuid    @id @map("user_id")
  secret        String
  confirmed     Boolean
  /// A replacement secret staged by enroll({ replace: true }); `secret` stays active until it is confirmed.
  pendingSecret String? @map("pending_secret")
  /// Last accepted time step, for replay protection. Only ever raised.
  lastUsedStep  Int?    @map("last_used_step")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("mfa_totp")
}

/// Hashes of a User's recovery codes; a code is spent by deleting its row.
model MfaRecoveryCode {
  userId Uuid   @map("user_id")
  hash   String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, hash])
  @@map("mfa_recovery_codes")
}

/// Failed second-factor attempts, counted inside the lockout window.
model MfaFailure {
  id     Uuid              @id @default(sql`gen_random_uuid()`)
  userId Uuid              @map("user_id")
  at     TimestamptzJsDate

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, at])
  @@index([at])
  @@map("mfa_failures")
}
